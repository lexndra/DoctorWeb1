# Пример настроек DW-1. Скопируйте в .env и при необходимости измените:  cp .env.example .env
# Файл .env не коммитится (см. .gitignore). Все переменные необязательны — ниже значения по умолчанию.
# Переменные окружения процесса имеют приоритет над .env.

# ---------------------------------------------------------------- Метод оценки
# features — интерпретируемая модель на признаках (CPU, только numpy/scikit-learn), по умолчанию;
# lm       — пословная языковая модель TNC-DBGC* (нужны requirements-lm.txt и .pt-чекпоинт);
# combined — взвешенная сумма features и lm.
DW1_METHOD=features

# Порог решения «сгенерировано ИИ» для итогового индекса (0..1).
# Пусто — порог берётся из файла калибровки (models/calibration.json, подобран на val).
DW1_THRESHOLD=

# Каталог с моделями: feature_model.json, calibration.json, lm_calibration.json, combined_calibration.json.
# По умолчанию — models/ в корне проекта.
DW1_MODELS_DIR=models

# Путь к весам языковой модели (.pt). Пусто — поиск по умолчанию:
# models/tnc_dbgc_llmtrace.pt, tnc_dbgc_llmtrace.pt, models/tnc_dbgc_coat_best.pt, tnc_dbgc_coat_best.pt.
# (Устаревшее имя переменной MODEL_CHECKPOINT тоже поддерживается.)
DW1_LM_CHECKPOINT=

# Устройство для языковой модели: cpu | cuda | mps. Пусто — выбирается автоматически.
DW1_LM_DEVICE=

# ---------------------------------------------------------------- Веса комбинирования
# Веса методов при DW1_METHOD=combined.
DW1_WEIGHT_FEATURES=0.5
DW1_WEIGHT_LM=0.5
# Доля оценки изображений в итоговом индексе (если анализ изображений включён и есть картинки).
DW1_WEIGHT_IMAGES=0.2
# Минимальный итоговый индекс при обнаружении утечки промпта (служебного текста LLM) в письме.
DW1_PROMPT_LEAK_FLOOR=0.9

# ---------------------------------------------------------------- Изображения
# 1 — включить анализ изображений (OCR, QR, детектор сгенерированных изображений);
# требует requirements-images.txt и заметно замедляет обработку. 0 — выключено.
DW1_ENABLE_IMAGES=0

# ---------------------------------------------------------------- Локальная LLM (только генерация датасета)
# OpenAI-совместимый API, например Ollama или LM Studio, используется командой `python cli.py generate`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Для локальных серверов ключ не нужен; реальный ключ указывайте только в .env, не в этом файле.
LLM_API_KEY=local
# Таймаут одного запроса к LLM, секунды.
LLM_TIMEOUT=180
